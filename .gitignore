# ==========================================================
# .gitignore —— 告诉 Git「哪些文件不用管」
# 课程：南昌大学 · 人机（AI）编程 2 · 个人作品集仓库
# ==========================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/
ipython_config.py

# ---------- Node.js / 前端 ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.cache/
.parcel-cache/
.vite/

# ---------- 数据与成果物（体积大 / 可再生成）----------
*.csv
*.tsv
*.xlsx
*.xlsm
!sample-data/**/*.csv
*.db
*.sqlite
*.sqlite3
*.parquet
*.h5
*.pkl
*.joblib
*.npz

# ---------- 多媒体素材 ----------
*.mp4
*.avi
*.mov
*.mkv
*.mp3
*.wav
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.pdf
zip/
*.zip
*.rar
*.7z
*.tar.gz

# ---------- 环境变量与密钥（非常重要！禁止上传）----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.*
config.local.*

# ---------- AI / 编辑器 / 系统 ----------
# AI 工具本地缓存可根据需要调整是否忽略
.aider*
.cursorrules
.claude/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.swp
*.swo

# ---------- IDE ----------
.idea/
.vscode/*
!.vscode/settings.example.json
*.code-workspace
.history/

# ---------- 日志 ----------
*.log
logs/
